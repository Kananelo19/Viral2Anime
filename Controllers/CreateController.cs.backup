using System.Text.Json;
using Microsoft.AspNetCore.Mvc;
using Viral2Anime.Data;
using Viral2Anime.Models.Project;
using Viral2Anime.Models.Story;
using Viral2Anime.Models.Video;
using Viral2Anime.Services.Animation;
using Viral2Anime.Services.ProjectState;
using Viral2Anime.Services.StoryGeneration;
using Viral2Anime.Services.VideoAnalysis;

namespace Viral2Anime.Controllers;

public class CreateController : Controller
{
    private readonly IWebHostEnvironment _environment;
    private readonly VideoMetadataService _metadataService;
    private readonly FrameExtractionService _frameExtractionService;
    private readonly GeminiVideoAnalysisService _geminiVideoAnalysisService;
    private readonly AnimeStoryboardService _animeStoryboardService;
    private readonly ReferenceFrameService _referenceFrameService;
    private readonly AnimeKeyframeService _animeKeyframeService;
    private readonly AnimeShotAnimationService _animeShotAnimationService;
    private readonly FinalVideoAssemblyService _finalVideoAssemblyService;
    private readonly IConfiguration _configuration;
    private readonly ProjectProcessingStore _projectStore;
    private readonly ApplicationDbContext _dbContext;

    public CreateController(
        IWebHostEnvironment environment,
        VideoMetadataService metadataService,
        FrameExtractionService frameExtractionService,
        GeminiVideoAnalysisService geminiVideoAnalysisService,
        AnimeStoryboardService animeStoryboardService,
        ReferenceFrameService referenceFrameService,
        AnimeKeyframeService animeKeyframeService,
        AnimeShotAnimationService animeShotAnimationService,
        FinalVideoAssemblyService finalVideoAssemblyService,
        IConfiguration configuration,
        ProjectProcessingStore projectStore,
        ApplicationDbContext dbContext)
    {
        _environment = environment;
        _metadataService = metadataService;
        _frameExtractionService = frameExtractionService;
        _geminiVideoAnalysisService = geminiVideoAnalysisService;
        _animeStoryboardService = animeStoryboardService;
        _referenceFrameService = referenceFrameService;
        _animeKeyframeService = animeKeyframeService;
        _animeShotAnimationService = animeShotAnimationService;
        _finalVideoAssemblyService = finalVideoAssemblyService;
        _configuration = configuration;
        _projectStore = projectStore;
        _dbContext = dbContext;
    }

    [HttpGet]
    public IActionResult Index()
    {
        return View();
    }

    [HttpPost]
    [RequestSizeLimit(500_000_000)]
    public async Task<IActionResult> Index(
        IFormFile video,
        string title,
        string outputType)
    {
        if (video == null || video.Length == 0)
        {
            ViewBag.Error = "Select a video first.";
            return View();
        }

        var uploadsFolder = Path.Combine(
            _environment.WebRootPath,
            "uploads");

        Directory.CreateDirectory(uploadsFolder);

        var extension = Path.GetExtension(video.FileName);
        var storedFileName = $"{Guid.NewGuid()}{extension}";

        var filePath = Path.Combine(
            uploadsFolder,
            storedFileName);

        await using (var stream =
            new FileStream(filePath, FileMode.Create))
        {
            await video.CopyToAsync(stream);
        }

        var project = new VideoProject
        {
            Title = string.IsNullOrWhiteSpace(title)
                ? Path.GetFileNameWithoutExtension(video.FileName)
                : title,

            OriginalFileName = video.FileName,
            StoredFileName = storedFileName,

            OutputType = string.IsNullOrWhiteSpace(outputType)
                ? "30 Second Short"
                : outputType
        };

        await _metadataService.PopulateMetadataAsync(
            project,
            filePath);

        var frameFolderName =
            project.Id.ToString();

        var frameFolderPath = Path.Combine(
            _environment.WebRootPath,
            "generated",
            "frames",
            frameFolderName);

        var extractedFrames =
            await _frameExtractionService.ExtractFramesAsync(
                filePath,
                frameFolderPath,
                3);

        ViewBag.FrameUrls =
            extractedFrames
                .Select(path =>
                    "/generated/frames/" +
                    frameFolderName +
                    "/" +
                    Path.GetFileName(path))
                .ToList();

        try
        {
            var analysis =
                await _geminiVideoAnalysisService
                    .AnalyzeVideoAsync(
                        filePath,
                        project.ContentType);

            ViewBag.AiAnalysis = analysis;

            var storyboard =
                await _animeStoryboardService
                    .GenerateStoryboardAsync(
                        analysis,
                        project.OutputType,
                        project.AnimationStyle);

            ViewBag.Storyboard = storyboard;

            var referenceFolderName =
                project.Id.ToString();

            var referenceFolderPath =
                Path.Combine(
                    _environment.WebRootPath,
                    "generated",
                    "references",
                    referenceFolderName);

            var referenceFrames =
                await _referenceFrameService
                    .ExtractExactFramesAsync(
                        storyboard,
                        filePath,
                        referenceFolderPath,
                        referenceFolderName);

            ViewBag.ReferenceFrames =
                referenceFrames;


            _projectStore.Save(
                new ProjectProcessingSession
                {
                    Project = project,
                    Analysis = analysis,
                    Storyboard = storyboard,
                    ReferenceFrames = referenceFrames
                });


            var dbProject =
                new ViralProject
                {
                    Id = project.Id,
                    Title = project.Title,
                    OriginalFileName =
                        project.OriginalFileName,
                    StoredFileName =
                        project.StoredFileName,
                    ContentType =
                        project.ContentType,
                    OutputType =
                        project.OutputType,
                    AnimationStyle =
                        project.AnimationStyle,
                    DurationSeconds =
                        project.DurationSeconds,
                    Width =
                        project.Width,
                    Height =
                        project.Height,
                    FramesPerSecond =
                        project.FramesPerSecond,
                    HasAudio =
                        project.HasAudio,
                    FormatName =
                        project.FormatName,

                    Stage =
                        ProjectStage.ReferencesReady,

                    AnalysisJson =
                        JsonSerializer.Serialize(
                            analysis),

                    StoryboardJson =
                        JsonSerializer.Serialize(
                            storyboard),

                    ReferenceFramesJson =
                        JsonSerializer.Serialize(
                            referenceFrames),

                    CreatedAt =
                        DateTime.UtcNow,

                    UpdatedAt =
                        DateTime.UtcNow
                };

            _dbContext.ViralProjects.Add(
                dbProject);

            await _dbContext.SaveChangesAsync();

            var autoGenerateKeyframes =
                _configuration.GetValue<bool>(
                    "Viral2Anime:AutoGenerateKeyframes");

            ViewBag.AutoGenerateKeyframes =
                autoGenerateKeyframes;

            if (autoGenerateKeyframes)
            {
                var keyframes = new List<Viral2Anime.Models.Story.AnimeKeyframe>();

                var keyframeFolderName =
                    project.Id.ToString();

                var keyframeFolderPath =
                    Path.Combine(
                        _environment.WebRootPath,
                        "generated",
                        "keyframes",
                        keyframeFolderName);

                foreach (var shot in storyboard.Shots
                             .OrderBy(shot => shot.ShotNumber))
                {
                    var referenceFrame =
                        referenceFrames.FirstOrDefault(
                            frame =>
                                frame.ShotNumber ==
                                shot.ShotNumber);

                    if (referenceFrame == null)
                    {
                        continue;
                    }

                    var keyframe =
                        await _animeKeyframeService
                            .GenerateKeyframeAsync(
                                shot,
                                referenceFrame,
                                keyframeFolderPath);

                    keyframe.GeneratedImageUrl =
                        "/generated/keyframes/" +
                        keyframeFolderName +
                        "/" +
                        Path.GetFileName(
                            keyframe.GeneratedImagePath);

                    keyframes.Add(keyframe);
                }

                ViewBag.AnimeKeyframes =
                    keyframes;
            }
            else
            {
                ViewBag.AnimeKeyframes =
                    new List<Viral2Anime.Models.Story.AnimeKeyframe>();
            }
        }
        catch (Exception ex)
        {
            ViewBag.AiError = ex.Message;
        }

        return View(
            "Uploaded",
            project);
    }


    [HttpPost]
    public async Task<IActionResult> GenerateShot(
        Guid projectId,
        int shotNumber)
    {
        var session =
            await GetOrRestoreSessionAsync(projectId);

        if (session == null)
        {
            return NotFound(
                "Project session was not found. Re-upload the video.");
        }

        var shot =
            session.Storyboard.Shots
                .FirstOrDefault(
                    item =>
                        item.ShotNumber == shotNumber);

        if (shot == null)
        {
            return NotFound(
                $"Storyboard shot {shotNumber} was not found.");
        }

        var referenceFrame =
            session.ReferenceFrames
                .FirstOrDefault(
                    frame =>
                        frame.ShotNumber == shotNumber);

        if (referenceFrame == null)
        {
            return NotFound(
                $"Reference frame for shot {shotNumber} was not found.");
        }

        var keyframeFolderName =
            session.Project.Id.ToString();

        var keyframeFolderPath =
            Path.Combine(
                _environment.WebRootPath,
                "generated",
                "keyframes",
                keyframeFolderName);

        try
        {
            var keyframe =
                await _animeKeyframeService
                    .GenerateKeyframeAsync(
                        shot,
                        referenceFrame,
                        keyframeFolderPath);

            keyframe.GeneratedImageUrl =
                "/generated/keyframes/" +
                keyframeFolderName +
                "/" +
                Path.GetFileName(
                    keyframe.GeneratedImagePath);

            session.GeneratedKeyframes.RemoveAll(
                item =>
                    item.ShotNumber == shotNumber);

            session.GeneratedKeyframes.Add(
                keyframe);

            var dbProject =
                await _dbContext.ViralProjects
                    .FindAsync(projectId);

            if (dbProject != null)
            {
                dbProject.GeneratedKeyframesJson =
                    JsonSerializer.Serialize(
                        session.GeneratedKeyframes);

                dbProject.Stage =
                    session.GeneratedKeyframes.Count >=
                    session.Storyboard.Shots.Count
                        ? ProjectStage.KeyframesReady
                        : ProjectStage.ReferencesReady;

                dbProject.UpdatedAt =
                    DateTime.UtcNow;

                await _dbContext
                    .SaveChangesAsync();
            }

            return Json(new
            {
                success = true,
                shotNumber = keyframe.ShotNumber,
                title = keyframe.Title,
                sourceFrameUrl = keyframe.SourceFrameUrl,
                generatedImageUrl = keyframe.GeneratedImageUrl
            });
        }
        catch (Exception ex)
        {
            return BadRequest(new
            {
                success = false,
                message = ex.Message
            });
        }
    }


    [HttpPost]
    public async Task<IActionResult> AnimateShot(
        Guid projectId,
        int shotNumber)
    {
        var session =
            await GetOrRestoreSessionAsync(projectId);

        if (session == null)
        {
            return NotFound(new
            {
                success = false,
                message = "Project was not found."
            });
        }

        var shot =
            session.Storyboard.Shots
                .FirstOrDefault(
                    item =>
                        item.ShotNumber == shotNumber);

        if (shot == null)
        {
            return NotFound(new
            {
                success = false,
                message =
                    $"Storyboard shot {shotNumber} was not found."
            });
        }

        var keyframe =
            session.GeneratedKeyframes
                .FirstOrDefault(
                    item =>
                        item.ShotNumber == shotNumber);

        if (keyframe == null ||
            !keyframe.GeneratedSuccessfully)
        {
            return BadRequest(new
            {
                success = false,
                message =
                    "Generate the anime keyframe before animating this shot."
            });
        }

        try
        {
            var clipFolderName =
                projectId.ToString();

            var clipFolderPath =
                Path.Combine(
                    _environment.WebRootPath,
                    "generated",
                    "clips",
                    clipFolderName);

            var clip =
                await _animeShotAnimationService
                    .GenerateClipAsync(
                        shot,
                        keyframe,
                        clipFolderPath);

            clip.ClipUrl =
                "/generated/clips/" +
                clipFolderName +
                "/" +
                Path.GetFileName(
                    clip.ClipPath);

            session.AnimatedClips.RemoveAll(
                item =>
                    item.ShotNumber == shotNumber);

            session.AnimatedClips.Add(
                clip);

            var dbProject =
                await _dbContext.ViralProjects
                    .FindAsync(projectId);

            if (dbProject != null)
            {
                dbProject.AnimatedClipsJson =
                    JsonSerializer.Serialize(
                        session.AnimatedClips);

                if (session.AnimatedClips.Count >=
                    session.Storyboard.Shots.Count)
                {
                    dbProject.Stage =
                        ProjectStage.Animated;
                }

                dbProject.UpdatedAt =
                    DateTime.UtcNow;

                await _dbContext
                    .SaveChangesAsync();
            }

            return Json(new
            {
                success = true,
                shotNumber = clip.ShotNumber,
                title = clip.Title,
                clipUrl = clip.ClipUrl,
                durationSeconds =
                    clip.DurationSeconds
            });
        }
        catch (Exception ex)
        {
            return BadRequest(new
            {
                success = false,
                message = ex.Message
            });
        }
    }


    [HttpPost]
    public async Task<IActionResult> RenderFinal(
        Guid projectId)
    {
        var session =
            await GetOrRestoreSessionAsync(projectId);

        if (session == null)
        {
            return NotFound(new
            {
                success = false,
                message = "Project was not found."
            });
        }

        var totalShots =
                session.Storyboard.Shots.Count;

            var completedShots =
                session.AnimatedClips
                    .Where(clip =>
                        clip.GeneratedSuccessfully &&
                        File.Exists(clip.ClipPath))
                    .Select(clip => clip.ShotNumber)
                    .Distinct()
                    .Count();

            if (totalShots == 0)
            {
                return BadRequest(
                    new
                    {
                        success = false,
                        message =
                            "This project has no storyboard shots."
                    });
            }

            if (completedShots < totalShots)
            {
                return BadRequest(
                    new
                    {
                        success = false,
                        message =
                            $"Final render requires every shot. " +
                            $"{completedShots}/{totalShots} " +
                            $"shots are animated."
                    });
            }

            if (session.AnimatedClips.Count == 0)
        {
            return BadRequest(new
            {
                success = false,
                message =
                    "Animate at least one shot before rendering."
            });
        }

        try
        {
            var finalFolderPath =
                Path.Combine(
                    _environment.WebRootPath,
                    "generated",
                    "final",
                    projectId.ToString());

            var finalVideo =
                await _finalVideoAssemblyService
                    .AssembleAsync(
                        projectId,
                        session.AnimatedClips,
                        finalFolderPath);

            finalVideo.VideoUrl =
                "/generated/final/" +
                projectId +
                "/" +
                Path.GetFileName(
                    finalVideo.FilePath);

            session.FinalVideoUrl =
                finalVideo.VideoUrl;

            var dbProject =
                await _dbContext.ViralProjects
                    .FindAsync(projectId);

            if (dbProject != null)
            {
                dbProject.FinalVideoFileName =
                    Path.GetFileName(
                        finalVideo.FilePath);

                dbProject.AnimatedClipsJson =
                    JsonSerializer.Serialize(
                        session.AnimatedClips);

                dbProject.Stage =
                    ProjectStage.Rendered;

                dbProject.UpdatedAt =
                    DateTime.UtcNow;

                await _dbContext
                    .SaveChangesAsync();
            }

            return Json(new
            {
                success = true,
                videoUrl =
                    finalVideo.VideoUrl,
                durationSeconds =
                    finalVideo.DurationSeconds,
                shotCount =
                    finalVideo.ShotCount
            });
        }
        catch (Exception ex)
        {
            return BadRequest(new
            {
                success = false,
                message = ex.Message
            });
        }
    }


    private async Task<ProjectProcessingSession?>
        GetOrRestoreSessionAsync(
            Guid projectId)
    {
        var existing =
            _projectStore.Get(projectId);

        if (existing != null)
        {
            return existing;
        }

        var dbProject =
            await _dbContext.ViralProjects
                .FindAsync(projectId);

        if (dbProject == null)
        {
            return null;
        }

        var options =
            new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

        var analysis =
            string.IsNullOrWhiteSpace(
                dbProject.AnalysisJson)
                ? new VideoAnalysisResult()
                : JsonSerializer.Deserialize<
                    VideoAnalysisResult>(
                        dbProject.AnalysisJson,
                        options)
                    ?? new VideoAnalysisResult();

        var storyboard =
            string.IsNullOrWhiteSpace(
                dbProject.StoryboardJson)
                ? new AnimeStoryboard()
                : JsonSerializer.Deserialize<
                    AnimeStoryboard>(
                        dbProject.StoryboardJson,
                        options)
                    ?? new AnimeStoryboard();

        var references =
            string.IsNullOrWhiteSpace(
                dbProject.ReferenceFramesJson)
                ? new List<
                    StoryboardReferenceFrame>()
                : JsonSerializer.Deserialize<
                    List<StoryboardReferenceFrame>>(
                        dbProject.ReferenceFramesJson,
                        options)
                    ?? new List<
                        StoryboardReferenceFrame>();

        var keyframes =
            string.IsNullOrWhiteSpace(
                dbProject.GeneratedKeyframesJson)
                ? new List<AnimeKeyframe>()
                : JsonSerializer.Deserialize<
                    List<AnimeKeyframe>>(
                        dbProject.GeneratedKeyframesJson,
                        options)
                    ?? new List<AnimeKeyframe>();

        var clips =
            string.IsNullOrWhiteSpace(
                dbProject.AnimatedClipsJson)
                ? new List<AnimeShotClip>()
                : JsonSerializer.Deserialize<
                    List<AnimeShotClip>>(
                        dbProject.AnimatedClipsJson,
                        options)
                    ?? new List<AnimeShotClip>();

        var project =
            new VideoProject
            {
                Id = dbProject.Id,
                Title = dbProject.Title,
                OriginalFileName =
                    dbProject.OriginalFileName,
                StoredFileName =
                    dbProject.StoredFileName,
                ContentType =
                    dbProject.ContentType,
                OutputType =
                    dbProject.OutputType,
                AnimationStyle =
                    dbProject.AnimationStyle,
                DurationSeconds =
                    dbProject.DurationSeconds,
                Width =
                    dbProject.Width,
                Height =
                    dbProject.Height,
                FramesPerSecond =
                    dbProject.FramesPerSecond,
                HasAudio =
                    dbProject.HasAudio,
                FormatName =
                    dbProject.FormatName,
                CreatedAt =
                    dbProject.CreatedAt
            };

        var session =
            new ProjectProcessingSession
            {
                Project = project,
                Analysis = analysis,
                Storyboard = storyboard,
                ReferenceFrames = references,
                GeneratedKeyframes = keyframes,
                AnimatedClips = clips
            };

        if (!string.IsNullOrWhiteSpace(
            dbProject.FinalVideoFileName))
        {
            session.FinalVideoUrl =
                "/generated/final/" +
                projectId +
                "/" +
                dbProject.FinalVideoFileName;
        }

        _projectStore.Save(session);

        return session;
    }

}
