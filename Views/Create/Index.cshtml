@{
    ViewData["Title"] = "Create Anime";
}

<div class="py-5"
     style="max-width: 850px; margin: 0 auto;">

    <div class="mb-4">

        <small class="text-muted">
            VIRAL2ANIME STUDIO
        </small>

        <h1 class="fw-bold display-5 mb-2">
            Create Anime
        </h1>

        <p class="text-muted">
            Upload real video, detect its strongest moments,
            build an anime storyboard and produce a social-ready video.
        </p>

    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form
        method="post"
        enctype="multipart/form-data"
        class="card">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">
                Project
            </h4>

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Project title
                </label>

                <input
                    type="text"
                    name="title"
                    class="form-control form-control-lg"
                    placeholder="Arsenal vs Liverpool" />

            </div>

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Source video
                </label>

                <input
                    type="file"
                    name="video"
                    accept="video/*"
                    class="form-control"
                    required />

                <div class="form-text">
                    Viral2Anime will inspect, analyze and extract
                    reference moments from this video.
                </div>

            </div>

            <hr class="my-4" />

            <h4 class="fw-bold mb-4">
                Anime Output
            </h4>

            <div class="row g-4">

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Output type
                    </label>

                    <select
                        id="outputType"
                        name="outputType"
                        class="form-select">

                        <option value="30 Second Short">
                            30 Second Short
                        </option>

                        <option value="60 Second Short">
                            60 Second Short
                        </option>

                        <option value="Anime Episode">
                            Anime Episode
                        </option>

                    </select>

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Target duration
                    </label>

                    <select
                        id="targetDurationSeconds"
                        name="targetDurationSeconds"
                        class="form-select">

                        <option value="30">
                            30 seconds
                        </option>

                        <option value="60">
                            60 seconds
                        </option>

                        <option value="90">
                            90 seconds
                        </option>

                        <option value="180">
                            3 minutes
                        </option>

                    </select>

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Aspect ratio
                    </label>

                    <select
                        id="aspectRatio"
                        name="aspectRatio"
                        class="form-select">

                        <option value="9:16">
                            9:16 — TikTok / Reels / Shorts
                        </option>

                        <option value="16:9">
                            16:9 — YouTube / Landscape
                        </option>

                        <option value="1:1">
                            1:1 — Square
                        </option>

                    </select>

                </div>

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Resolution
                    </label>

                    <select
                        id="outputResolution"
                        name="outputResolution"
                        class="form-select">

                        <option value="1080x1920">
                            1080 × 1920
                        </option>

                        <option value="1920x1080">
                            1920 × 1080
                        </option>

                        <option value="1080x1080">
                            1080 × 1080
                        </option>

                        <option value="720x1280">
                            720 × 1280
                        </option>

                        <option value="1280x720">
                            1280 × 720
                        </option>

                    </select>

                </div>

            </div>

            <div class="mt-4">

                <label class="form-label fw-semibold">
                    Audio
                </label>

                <select
                    name="audioMode"
                    class="form-select">

                    <option value="Mute">
                        Mute — animation only
                    </option>

                    <option value="Original Audio">
                        Original Audio — keep source sound
                    </option>

                </select>

                <div class="form-text">
                    Mute is recommended while developing.
                    Original audio can be included during export.
                </div>

            </div>

            <div class="alert alert-light border mt-4 mb-0">

                <strong>Animation style:</strong>
                Cinematic Anime

                <br />

                <small class="text-muted">
                    Additional styles can be added after the
                    core production pipeline is validated.
                </small>

            </div>

        </div>

        <div class="card-footer bg-white p-4">

            <button
                type="submit"
                class="btn btn-dark btn-lg w-100">

                Upload & Analyze

            </button>

        </div>

    </form>

</div>


<script>
document.addEventListener(
    "DOMContentLoaded",
    function () {

        const outputType =
            document.getElementById(
                "outputType");

        const targetDuration =
            document.getElementById(
                "targetDurationSeconds");

        const aspectRatio =
            document.getElementById(
                "aspectRatio");

        const resolution =
            document.getElementById(
                "outputResolution");


        outputType.addEventListener(
            "change",
            function () {

                if (this.value ===
                    "30 Second Short") {

                    targetDuration.value =
                        "30";
                }

                else if (this.value ===
                    "60 Second Short") {

                    targetDuration.value =
                        "60";
                }

                else {

                    targetDuration.value =
                        "180";
                }
            });


        aspectRatio.addEventListener(
            "change",
            function () {

                if (this.value === "9:16") {

                    resolution.value =
                        "1080x1920";
                }

                else if (
                    this.value === "16:9") {

                    resolution.value =
                        "1920x1080";
                }

                else {

                    resolution.value =
                        "1080x1080";
                }
            });

    });
</script>
