@using Viral2Anime.Models.Video
@model Viral2Anime.Models.Video.VideoProject

@{
    ViewData["Title"] = "Video Uploaded";

    var duration = TimeSpan.FromSeconds(Model.DurationSeconds);
    var frameUrls = ViewBag.FrameUrls as List<string> ?? new List<string>();
    var analysis = ViewBag.AiAnalysis as VideoAnalysisResult;
    var aiError = ViewBag.AiError as string;
}

<div class="container mt-5" style="max-width: 1100px;">

    <h1 class="fw-bold">Video Ready</h1>

    <div class="card mt-4">
        <div class="card-body">

            <h4>@Model.Title</h4>

            <p>
                <strong>Original file:</strong>
                @Model.OriginalFileName
            </p>

            <p>
                <strong>Output:</strong>
                @Model.OutputType
            </p>

            <p>
                <strong>Animation style:</strong>
                @Model.AnimationStyle
            </p>

            <hr />

            <h5>Video Inspection</h5>

            <p>
                <strong>Duration:</strong>
                @duration.ToString(@"mm\:ss")
            </p>

            <p>
                <strong>Resolution:</strong>
                @Model.Width × @Model.Height
            </p>

            <p>
                <strong>FPS:</strong>
                @Model.FramesPerSecond.ToString("0.##")
            </p>

            <p>
                <strong>Audio:</strong>
                @(Model.HasAudio ? "Yes" : "No")
            </p>

            <p>
                <strong>Format:</strong>
                @Model.FormatName
            </p>

        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(aiError))
    {
        <div class="alert alert-danger mt-4">
            <strong>AI analysis failed:</strong>
            @aiError
        </div>
    }

    @if (analysis != null)
    {
        <div class="mt-5">

            <h2 class="fw-bold">
                AI Highlight Analysis
            </h2>

            <div class="row g-3 mt-2">

                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body">

                            <div class="text-muted">
                                Highlight Score
                            </div>

                            <div class="display-4 fw-bold">
                                @analysis.HighlightScore
                            </div>

                            <div class="text-muted">
                                / 100
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="card h-100">
                        <div class="card-body">

                            <h5>Video Summary</h5>

                            <p>
                                @analysis.Summary
                            </p>

                        </div>
                    </div>
                </div>

            </div>

            <div class="card mt-3">
                <div class="card-body">

                    <h4 class="fw-bold">
                        Best Moment
                    </h4>

                    <p>
                        <strong>Time:</strong>
                        @analysis.BestMomentStartSeconds.ToString("0.0")s
                        -
                        @analysis.BestMomentEndSeconds.ToString("0.0")s
                    </p>

                    <p>
                        @analysis.BestMomentDescription
                    </p>

                </div>
            </div>

            <div class="card mt-3">
                <div class="card-body">

                    <h4 class="fw-bold">
                        Anime Concept
                    </h4>

                    <p>
                        @analysis.AnimeConcept
                    </p>

                </div>
            </div>

            @if (analysis.Moments.Count > 0)
            {
                <div class="mt-4">

                    <h3 class="fw-bold">
                        Highlight Timeline
                    </h3>

                    @foreach (var moment in analysis.Moments)
                    {
                        <div class="card mt-3">
                            <div class="card-body">

                                <div class="d-flex justify-content-between">
                                    <h5 class="fw-bold">
                                        @moment.Type
                                    </h5>

                                    <span class="badge bg-dark">
                                        @moment.ImportanceScore / 100
                                    </span>
                                </div>

                                <p class="text-muted mb-2">
                                    @moment.StartSeconds.ToString("0.0")s
                                    -
                                    @moment.EndSeconds.ToString("0.0")s
                                </p>

                                <p>
                                    @moment.Description
                                </p>

                                <hr />

                                <strong>Anime Direction</strong>

                                <p class="mt-2 mb-0">
                                    @moment.AnimeDirection
                                </p>

                            </div>
                        </div>
                    }

                </div>
            }

        </div>
    }

    @if (frameUrls.Count > 0)
    {
        <div class="mt-5">

            <h3 class="fw-bold">
                Extracted Frames
            </h3>

            <div class="row g-3 mt-2">

                @foreach (var frameUrl in frameUrls)
                {
                    <div class="col-md-4">

                        <div class="card h-100">

                            <img
                                src="@frameUrl"
                                class="card-img-top"
                                alt="Extracted video frame"
                                style="height: 190px; object-fit: cover;" />

                        </div>

                    </div>
                }

            </div>

        </div>
    }

    <a asp-controller="Create"
       asp-action="Index"
       class="btn btn-dark mt-5 mb-5">
        Upload Another Video
    </a>

</div>
