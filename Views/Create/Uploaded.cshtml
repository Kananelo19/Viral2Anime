@model Viral2Anime.Models.Video.VideoProject

@{
    ViewData["Title"] = "Video Uploaded";
    var duration = TimeSpan.FromSeconds(Model.DurationSeconds);
    var frameUrls = ViewBag.FrameUrls as List<string> ?? new List<string>();
}

<div class="container mt-5" style="max-width: 980px;">

    <h1 class="fw-bold">Video Ready</h1>

    <div class="card mt-4">
        <div class="card-body">

            <h4>@Model.Title</h4>

            <p>
                <strong>Original file:</strong>
                @Model.OriginalFileName
            </p>

            <p>
                <strong>Output:</strong>
                @Model.OutputType
            </p>

            <p>
                <strong>Animation style:</strong>
                @Model.AnimationStyle
            </p>

            <hr />

            <h5>Video Analysis</h5>

            <p>
                <strong>Duration:</strong>
                @duration.ToString(@"mm\:ss")
            </p>

            <p>
                <strong>Resolution:</strong>
                @Model.Width × @Model.Height
            </p>

            <p>
                <strong>FPS:</strong>
                @Model.FramesPerSecond.ToString("0.##")
            </p>

            <p>
                <strong>Audio:</strong>
                @(Model.HasAudio ? "Yes" : "No")
            </p>

            <p>
                <strong>Format:</strong>
                @Model.FormatName
            </p>

            <p>
                <strong>Frames extracted:</strong>
                @frameUrls.Count
            </p>

            <div class="alert alert-success mt-4">
                Video inspection and frame extraction complete.
            </div>

        </div>
    </div>

    @if (frameUrls.Count > 0)
    {
        <div class="mt-5">

            <h3 class="fw-bold">
                Extracted Frames
            </h3>

            <p class="text-muted">
                These frames will be used for scene and highlight analysis.
            </p>

            <div class="row g-3 mt-2">

                @foreach (var frameUrl in frameUrls)
                {
                    <div class="col-md-4">

                        <div class="card h-100">

                            <img
                                src="@frameUrl"
                                class="card-img-top"
                                alt="Extracted video frame"
                                style="height: 190px; object-fit: cover;" />

                        </div>

                    </div>
                }

            </div>

        </div>
    }

    <a asp-controller="Create"
       asp-action="Index"
       class="btn btn-dark mt-5">
        Upload Another Video
    </a>

</div>
